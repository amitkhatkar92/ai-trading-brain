# =============================================================================
# IIOS — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── .env files (SECRETS — never commit real credentials) ─────────────────────
.env
.env.*
!.env.example        # Always commit the example template

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.hypothesis/

# ── Coverage ──────────────────────────────────────────────────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── Logs (runtime generated — not source) ────────────────────────────────────
logs/
*.log
*.log.*

# ── IIOS Runtime data ─────────────────────────────────────────────────────────
# data/ is intentionally NOT gitignored — iios.db and paper_trades.csv
# must persist across deploys. Only derived/temporary files are excluded.
data/reports/
data/backups/
data/*.bak
data/.bootstrap_probe
data/.hc_probe
data/replay.db

# ── Large runtime-grown knowledge stores (written by momentum_knowledge_builder)
# These grow to 30-100MB on VPS and must NOT be overwritten by git pull.
# The seed content (2,356 records) is committed once; the VPS version is live.
data/knowledge_evidence_ledger.jsonl
data/shadow_evidence_ledger.jsonl

# ── Runtime state files — updated every cycle on VPS; wiping resets live state ──
# fresh-deploy is graceful (system rebuilds empty state automatically).
data/ksl/*.json
data/research_question_queue.jsonl
data/regime_probability_history.json
data/scanner_memory.json
data/iv_history.json
data/lol/LOL_*.jsonl

# ── Options runtime data — generated fresh each session ──────────────────────
data/options_*.json
data/options_*.jsonl
data/options_*.csv

# ── Other runtime state files ─────────────────────────────────────────────────
data/scheduler_health.json
data/trade_analytics_*.json

# ── Strategy / learning runtime state — CRITICAL: never reset these ──────────
# git pull must NEVER overwrite these; they are the system's earned knowledge.
data/strategy_performance.json      # win rates per strategy — rebuilt every EOD
data/odm_state.json                 # OpportunityDensityMonitor signal tier history
data/knowledge_pipeline_health.json # KDA pipeline health metrics
data/ml_performance_dataset.json    # MetaLearning k-NN training records (21+ obs)
data/paper_trading_daily.json       # daily P&L summary

# ── Research outputs generated on VPS — months of accumulated work ────────────
data/discovered_edges.json          # 600KB+ discovered trading edges
data/evolved_strategies.json        # evolved strategy index cache
data/ars_hypothesis_registry.json   # ARS hypothesis registry
data/ars_study_*.json               # ARS study outputs
data/ars/rc/history.json            # ARS research coordinator history
data/mover_discovery_v3_shadow.jsonl
data/mover_discovery_v3_shadow_raw.jsonl
data/klp/knowledge_fusion/source_inventory.jsonl

# ── Docker ────────────────────────────────────────────────────────────────────
.docker-data/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Notebooks (analysis only, not production) ─────────────────────────────────
*.ipynb
.ipynb_checkpoints/

# ── Temporary analysis scripts ────────────────────────────────────────────────
analysis_temp.py
*_temp.py

# ── Benchmarks ────────────────────────────────────────────────────────────────
.benchmarks/

# ── Secrets baseline (DO commit this file once generated) ─────────────────────
# .secrets.baseline

# ── Broker token files (contain live JWTs — never commit) ─────────────────────
config/api_tokens.json