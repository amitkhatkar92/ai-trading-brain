logs/
*.log
*.log.*

# ── IIOS Runtime data ─────────────────────────────────────────────────────────
# data/ contains a mix of static reference data (tracked) and live runtime
# state (must NOT be tracked). Persistence across deploys/restarts comes
# from the Docker bind mount (./data:/app/data in docker-compose.yml) —
# NOT from git tracking. Tracking live runtime files is actively DANGEROUS:
# any future `git pull` on the VPS silently reverts them to whatever was
# last committed, discarding all live data with no warning. This caused a
# real production incident on 2026-09-04 (control_tower.db reverted to a
# months-old commit mid-deploy, wiping out same-day repairs) — see
# /memories/repo/incident_control_tower_db_git_tracked.md for the full
# post-mortem. The rule going forward: runtime databases/logs/CSVs are
# ALWAYS gitignored; only static config/reference JSON is ever tracked.
data/reports/
data/backups/
data/*.bak
data/.bootstrap_probe
data/.hc_probe
data/replay.db
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/mls/*.db
data/ikn/*.db
data/paper_trades*.csv
data/paper_trade_log.csv
data/live/*.jsonl

# ── Large runtime-grown knowledge stores (written by momentum_knowledge_builder)
# These grow to 30-100MB on VPS and must NOT be overwritten by git pull.
# The seed content (2,356 records) is committed once; the VPS version is live.
data/knowledge_evidence_ledger.jsonl
data/shadow_evidence_ledger.jsonl

# ── Runtime state files — updated every cycle on VPS; wiping resets live state ──
# fresh-deploy is graceful (system rebuilds empty state automatically).
data/ksl/*.json
data/kda_cre/
data/research_question_queue.jsonl
data/regime_probability_history.json
data/scanner_memory.json
data/iv_history.json
data/lol/LOL_*.jsonl

# ── Options runtime data — generated fresh each session ──────────────────────
data/options_*.json
data/options_*.jsonl
data/options_*.csv

# ── Other runtime state files ─────────────────────────────────────────────────
data/scheduler_health.json
data/trade_analytics_*.json

# ── Strategy / learning runtime state — CRITICAL: never reset these ──────────
# git pull must NEVER overwrite these; they are the system's earned knowledge.
# NOTE: each pattern MUST be on its own line with no trailing inline comment —
# gitignore treats "pattern  # comment" as one literal pattern (never matches).
# win rates per strategy — rebuilt every EOD
data/strategy_performance.json
# OpportunityDensityMonitor signal tier history
data/odm_state.json
# KDA pipeline health metrics
data/knowledge_pipeline_health.json
# MetaLearning k-NN training records (21+ obs)
data/ml_performance_dataset.json
# daily P&L summary
data/paper_trading_daily.json

# ── Research outputs generated on VPS — months of accumulated work ────────────
# 600KB+ discovered trading edges
data/discovered_edges.json
# evolved strategy index cache
data/evolved_strategies.json
# ARS hypothesis registry
data/ars_hypothesis_registry.json
# ARS study outputs
data/ars_study_*.json
# ARS research coordinator history
data/ars/rc/history.json
# ARS scheduler run history (Priority 1 activation)
data/ars/scheduler/
data/ars/sfr/
data/ars/sd/
data/ars_roadmap_state.json
data/mover_discovery_v3_shadow.jsonl
data/mover_discovery_v3_shadow_raw.jsonl
# Debate weight self-tuning (Priority 3 activation)
data/debate/

# ── Per-session monitoring / rebuild runtime state ────────────────────────────
data/monitor_state.json
data/nifty500_universe.json
data/closed_orders_*.txt
data/expiry_retries.json
data/borderline_rejections.json
data/stability_ledger.json
data/rejection_audit.db

# ── KDA daily comparison + scan attrition (written every intraday cycle) ──────
