data/klp/kda/
data/predictive_gap/
data/klp/knowledge_fusion/source_inventory.jsonl
data/klp/knowledge_fusion/source_inventory.jsonl

# ── DTA-MARKET-BENCHMARK-001 — daily benchmark outputs (written every EOD) ────
data/market_benchmark/

