[Unit]
Description=AI Trading Brain - Automated Schedule Mode
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai-trading-brain
EnvironmentFile=/root/ai-trading-brain/.env
Environment="PYTHONUNBUFFERED=1"
# NOTE: RUNNING_IN_DOCKER is intentionally NOT set here.
# main.py will detect it is not inside a container and exit immediately.
# This service file is kept only as a fallback reference; it must NOT be
# enabled.  Use docker compose (see deploy.yml) to run the engine.
ExecStart=/root/ai-trading-brain/venv/bin/python main.py --schedule
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-brain

# Graceful shutdown
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
